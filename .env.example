# 이 파일을 .env 로 복사한 뒤 값을 채우세요.

# ── 필수 ────────────────────────────────────────────────
# https://hf.co/settings/tokens 에서 read 토큰 생성
# 그리고 https://huggingface.co/pyannote/speaker-diarization-community-1 에서 약관 동의(게이트 승인)
HF_TOKEN=

# ── 모델 ────────────────────────────────────────────────
# NVIDIA GPU: large-v3 (정확도 최고)
# CPU / Mac  : large-v3-turbo (5~8배 빠르고 정확도 손실은 평균 0.4%p 수준)
WHISPER_MODEL=large-v3
DIARIZE_MODEL=pyannote/speaker-diarization-community-1

# ── 하드웨어 ─────────────────────────────────────────────
# auto : CUDA 있으면 CUDA, 없으면 CPU  (권장)
# cuda / cpu
# mps  : Apple Silicon GPU. 화자분리·정렬에만 적용되고 전사는 여전히 CPU 다
#        (CTranslate2 가 Metal 미지원). pyannote 의 MPS 커널이 불완전해
#        타임스탬프가 어긋난 사례가 있으니 결과를 꼭 확인하세요.
DEVICE=auto

# auto : CUDA=float16, 그 외=int8   (권장)
COMPUTE_TYPE=auto

# VRAM 부족(OOM) 시 8 -> 4 로 낮추세요. CPU 라면 4 권장.
BATCH_SIZE=8
# 그래도 OOM 이면 true 로 (단계마다 모델 언로드, 대신 느려짐)
UNLOAD_BETWEEN_STAGES=false

# ── 화자 자동 인식 튜닝 ───────────────────────────────────
# 코사인 유사도 임계값. 오인식 잦으면 올리고(0.65~0.70),
# 같은 사람을 못 알아보면 내리세요(0.50~0.55).
MATCH_THRESHOLD=0.60
# 1등과 2등 화자의 점수 차가 이 값 미만이면 애매하다고 보고 매칭 포기
MATCH_MARGIN=0.05
# 총 발화가 이 초 미만인 화자는 임베딩이 불안정해서 자동 매칭하지 않음
MIN_SPEECH_SEC=5.0
# 화자 1명당 보관할 보이스프린트 최대 개수
MAX_VOICEPRINTS=10

# ── 서버 ────────────────────────────────────────────────
HOST=127.0.0.1
PORT=8000
