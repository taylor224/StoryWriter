# Copy this file to .env and fill in the values.

# ── Required ────────────────────────────────────────────
# Create a read token at https://hf.co/settings/tokens
# Then accept the terms (gate approval) at
# https://huggingface.co/pyannote/speaker-diarization-community-1
HF_TOKEN=

# ── Models ──────────────────────────────────────────────
# large-v3-turbo : the default. 5-8x faster for about 0.4pp more word error.
#                  Its shallow decoder falls into repetition and hallucination
#                  more easily, so use it with silence removal and the
#                  hallucination filter on (both are on by default).
# large-v3       : maximum accuracy. Several times slower on long files.
WHISPER_MODEL=large-v3-turbo
DIARIZE_MODEL=pyannote/speaker-diarization-community-1

# ── Hardware ────────────────────────────────────────────
# auto : CUDA when available, otherwise CPU  (recommended)
# cuda / cpu
# mps  : Apple Silicon GPU. Only diarization and alignment use it; transcription
#        stays on CPU (CTranslate2 has no Metal support). pyannote's MPS kernels
#        are incomplete and have caused drifting timestamps, so check the output.
DEVICE=auto

# auto : float16 on CUDA, int8 otherwise  (recommended)
COMPUTE_TYPE=auto

# Lower to 4 if you run out of VRAM. 4 is a good value on CPU.
BATCH_SIZE=8
# Still out of memory? Set this to true (unloads models between stages, slower)
UNLOAD_BETWEEN_STAGES=false

# ── Audio filter ────────────────────────────────────────
# Clean up the sound before transcription. off | voice | denoise | declip
#
# Why the default is off: Whisper was trained on 680k hours of noisy real-world
# audio and is already robust to ordinary noise. Aggressive denoising creates
# artifacts it never saw in training, and accuracy often gets worse. Always
# compare results with and without before leaving it on.
#
# voice   : remove low rumble and lift up whoever sits far from the mic.
#           Useful when one person in the room is distant. Relatively safe.
# denoise : the above plus FFT denoising. For constant fan noise. Higher risk.
# declip  : repair a clipped (distorted) recording.
# You can also pass an ffmpeg filter string directly (e.g. highpass=f=120,dynaudnorm)
AUDIO_FILTER=off

# ── Silence removal ─────────────────────────────────────
# Cut long silences, then run transcription, alignment and diarization. The
# biggest time saving is in diarization (pyannote sweeps silence too). It also
# reduces Whisper inventing sentences over silence.
# The resulting time shift is undone internally, so result timestamps are always
# on the original audio's clock (playback positions never desync).
TRIM_SILENCE=true
# Only silence at least this long is cut. Short breaths and pauses are speech.
TRIM_MIN_SILENCE_SEC=0.8
# Headroom kept around each utterance. Raise it if first sounds get clipped.
TRIM_PAD_SEC=0.25
# Where the line sits between the noise floor and speech level (0-1).
# Lower it (0.20) if speech is being cut; raise it (0.40) if silence is not.
TRIM_SENSITIVITY=0.30
# Strip below this frequency before *judging* silence (Hz). 0 disables it.
# Fans and air conditioning sit below 100Hz and raise the noise floor enough to
# defeat silence detection entirely (a single 45Hz hum can do it).
# Used only for the decision — what goes to the models is the untouched waveform.
TRIM_HIGHPASS_HZ=80

# ── Chunked processing for long files ───────────────────
# Files longer than this (seconds) are processed in chunks. 0 disables it.
# This is about quality as much as speed — pyannote tends to split one person
# into several speakers on very long files.
# Boundaries land in the middle of silence, and speakers are stitched back
# together across chunks by voice.
CHUNK_SEC=3600
# Cosine threshold for "same person" across chunks.
# Lower it (0.55) if one person comes out as several; raise it (0.75) if
# different people get merged.
STITCH_THRESHOLD=0.65

# ── Re-merging over-split speakers ──────────────────────
# pyannote splits one person into several speakers often (tone shifts, mic
# distance, long files). At the end the final speakers are compared once more
# and merged. Applies to short files that were never chunked too. 0 disables it.
#
# Lower it (0.55-0.60) if one person is still split across several;
# raise it (0.72-0.78) if different people get merged into one.
MERGE_THRESHOLD=0.65
# Two speakers who overlapped for at least this long are never merged.
MERGE_MIN_OVERLAP_SEC=0.5

# ── Hallucination filter ────────────────────────────────
# Filters out sentences Whisper invented over noise:
#   "uh uh uh uh uh", broadcast sign-offs, "Thanks for watching", and so on.
# What was removed and why is recorded on the result page and in the json.
# Nothing is deleted on the text alone. Contentless repetition goes immediately;
# boilerplate only goes when there is evidence the audio does not back up the
# text. Anything else questionable stays and is merely flagged as suspect.
DROP_HALLUCINATION=true
# Evidence 1: mean alignment confidence below this. 0 drops just this evidence.
HALLUCINATION_MIN_SCORE=0.30
# true also removes everything that would only have been flagged. Real speech
# can be lost this way.
DROP_SUSPECT=false

# ── Speaker recognition tuning ──────────────────────────
# Cosine similarity threshold. Raise it (0.65-0.70) if people get misidentified,
# lower it (0.50-0.55) if the same person is not recognized.
MATCH_THRESHOLD=0.60
# If first and second place are closer than this, the match is too close to call
MATCH_MARGIN=0.05
# Speakers with less total speech than this are not auto-matched (unstable embedding)
MIN_SPEECH_SEC=5.0
# Maximum voiceprints kept per speaker
MAX_VOICEPRINTS=10

# ── Server ──────────────────────────────────────────────
HOST=127.0.0.1
PORT=8000
