# 이 파일을 .env 로 복사한 뒤 값을 채우세요.

# ── 필수 ────────────────────────────────────────────────
# https://hf.co/settings/tokens 에서 read 토큰 생성
# 그리고 https://huggingface.co/pyannote/speaker-diarization-community-1 에서 약관 동의(게이트 승인)
HF_TOKEN=

# ── 모델 ────────────────────────────────────────────────
# large-v3-turbo : 기본값. 5~8배 빠르고 단어오류율 차이는 평균 0.4%p 수준.
#                  디코더가 얕아 반복·환각에 더 잘 빠지므로 무음 제거와
#                  환각 필터를 켠 채로 쓸 것 (아래 둘 다 기본 켜짐).
# large-v3       : 정확도 최우선. 긴 파일은 몇 배 오래 걸린다.
WHISPER_MODEL=large-v3-turbo
DIARIZE_MODEL=pyannote/speaker-diarization-community-1

# ── 하드웨어 ─────────────────────────────────────────────
# auto : CUDA 있으면 CUDA, 없으면 CPU  (권장)
# cuda / cpu
# mps  : Apple Silicon GPU. 화자분리·정렬에만 적용되고 전사는 여전히 CPU 다
#        (CTranslate2 가 Metal 미지원). pyannote 의 MPS 커널이 불완전해
#        타임스탬프가 어긋난 사례가 있으니 결과를 꼭 확인하세요.
DEVICE=auto

# auto : CUDA=float16, 그 외=int8   (권장)
COMPUTE_TYPE=auto

# VRAM 부족(OOM) 시 8 -> 4 로 낮추세요. CPU 라면 4 권장.
BATCH_SIZE=8
# 그래도 OOM 이면 true 로 (단계마다 모델 언로드, 대신 느려짐)
UNLOAD_BETWEEN_STAGES=false

# ── 무음 제거 ───────────────────────────────────────────
# 긴 침묵을 잘라내고 전사·정렬·화자분리를 돌린다. 시간이 가장 많이 줄어드는
# 쪽은 화자분리다 (pyannote 는 침묵도 전부 훑는다). 침묵에서 Whisper 가
# 없는 말을 지어내는 것도 줄어든다.
# 잘라낸 만큼 시각이 당겨지는 문제는 내부에서 되돌리므로, 결과 타임스탬프는
# 언제나 원본 오디오 기준이다 (재생 위치가 어긋나지 않는다).
TRIM_SILENCE=true
# 이 길이 이상 이어지는 침묵만 잘라낸다. 짧은 숨·뜸은 말의 일부라 남긴다.
TRIM_MIN_SILENCE_SEC=0.8
# 발화 앞뒤로 남길 여유. 첫소리가 잘리면 올리세요.
TRIM_PAD_SEC=0.25
# 잡음 바닥과 발화 세기 사이 기준선 위치 (0~1).
# 말이 잘려 나가면 내리고(0.20), 무음이 안 잘리면 올리세요(0.40).
TRIM_SENSITIVITY=0.30

# ── 긴 파일 조각 처리 ────────────────────────────────────
# 이 길이(초)를 넘으면 조각으로 나눠 돌린다. 0 이면 끄기.
# 속도뿐 아니라 품질 문제이기도 하다 — pyannote 는 아주 긴 파일에서 같은
# 사람을 여러 명으로 갈라놓는 경향이 있다.
# 경계는 침묵 한가운데로 잡고, 조각 간 화자는 목소리로 다시 이어 붙인다.
CHUNK_SEC=3600
# 조각 간 "같은 사람" 판정 임계값 (코사인).
# 같은 사람이 여러 명으로 갈라지면 내리고(0.55), 다른 사람이 뭉치면 올리세요(0.75).
STITCH_THRESHOLD=0.65

# ── 과분할된 화자 다시 묶기 ───────────────────────────────
# pyannote 는 한 사람을 여러 화자로 쪼개는 일이 잦습니다 (목소리 톤 변화,
# 마이크 거리, 긴 파일). 마지막에 최종 화자들끼리 한 번 더 대조해 묶습니다.
# 조각을 나누지 않은 짧은 파일에도 적용됩니다. 0 이면 끄기.
#
# 한 사람이 아직도 여럿으로 나뉘면 내리고(0.55~0.60),
# 다른 사람이 한 명으로 뭉치면 올리세요(0.72~0.78).
MERGE_THRESHOLD=0.65
# 두 화자가 이 시간 이상 동시에 말했으면 절대 같은 사람으로 안 묶습니다.
MERGE_MIN_OVERLAP_SEC=0.5

# ── 환각 필터 ───────────────────────────────────────────
# Whisper 가 잡음 구간에서 지어낸 문장을 걸러낸다.
#   "아 아 아 아 아", "MBC 뉴스 OOO이었습니다", "시청해주셔서 감사합니다",
#   "Thanks for watching" 같은 것들.
# 무엇을 왜 지웠는지는 결과 페이지와 json 에 남는다.
# 글자만 보고는 지우지 않는다. 내용 없는 반복은 바로 버리고, 상투구는
# "소리가 그 글자를 뒷받침하지 않는다"는 증거가 있을 때만 버린다.
# 애매한 것은 결과에 남긴 채 "의심"으로 표시만 한다.
DROP_HALLUCINATION=true
# 증거 1: 정렬 신뢰도 평균이 이 값 미만. 0 이면 이 증거만 안 쓴다.
HALLUCINATION_MIN_SCORE=0.30
# true 면 "의심"으로 표시만 하던 것까지 전부 버린다. 진짜 발언을 잃을 수 있다.
DROP_SUSPECT=false

# ── 화자 자동 인식 튜닝 ───────────────────────────────────
# 코사인 유사도 임계값. 오인식 잦으면 올리고(0.65~0.70),
# 같은 사람을 못 알아보면 내리세요(0.50~0.55).
MATCH_THRESHOLD=0.60
# 1등과 2등 화자의 점수 차가 이 값 미만이면 애매하다고 보고 매칭 포기
MATCH_MARGIN=0.05
# 총 발화가 이 초 미만인 화자는 임베딩이 불안정해서 자동 매칭하지 않음
MIN_SPEECH_SEC=5.0
# 화자 1명당 보관할 보이스프린트 최대 개수
MAX_VOICEPRINTS=10

# ── 서버 ────────────────────────────────────────────────
HOST=127.0.0.1
PORT=8000
